* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    text-align: center;
    color: #5a1748;
    background: linear-gradient(135deg, #ffd6ec, #e8d7ff, #ffe5f2);
    min-height: 100vh;
    overflow-x: hidden;
}

.container {
    max-width: 850px;
    margin: auto;
    padding: 30px 16px 50px;
}

h1 {
    font-size: clamp(42px, 10vw, 78px);
