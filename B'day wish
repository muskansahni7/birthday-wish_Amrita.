}

.message {
    font-size: 20px;
    line-height: 1.6;
}

.cake {
    font-size: 90px;
    animation: bounce 1.5s infinite;
}

button {
    border: 0;
    border-radius: 30px;
    padding: 14px 25px;
    font-size: 18px;
    font-weight: bold;
    cursor: pointer;
    background: #ed3b91;
    color: white;
    box-shadow: 0 6px 15px rgba(200,40,120,.25);
}

button:active {
    transform: scale(.96);
}

#surprise {
    display: none;
    animation: reveal .8s ease;
}

.balloon {
    position: fixed;
    font-size: 35px;
    animation: float 7s linear infinite;
    pointer-events: none;
    z-index: 0;
}

.b1 {
    left: 5%;
    animation-delay: 0s;
}

.b2 {
    right: 7%;
    animation-delay: 2s;
}

.b3 {
    left: 45%;
    animation-delay: 4s;
}

@keyframes float {
    from {
        bottom: -60px;
        transform: translateY(0) rotate(0deg);
    }

    to {
        bottom: 110vh;
        transform: translateY(0) rotate(20deg);
    }
}

@keyframes pop {
    0% {
        transform: scale(.4);
        opacity: 0;
    }

    100% {
        transform: scale(1);
        opacity: 1;
    }
}

@keyframes bounce {
    0%,100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-12px);
    }
}

@keyframes reveal {
    from {
        opacity: 0;
        transform: translateY(25px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}
</style>
</head>

